<Window x:Class="XML_FAB.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый документ — XML FAB"
        Width="850" Height="650" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Сохранить черновик…"
                    Click="SaveDraft_Click"
                    Padding="14,8" />
        </StackPanel>

        <TabControl>
            <TabItem Header="1. Основные сведения">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="600"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Пояснительная записка"
                                   FontSize="23" FontWeight="SemiBold"
                                   Margin="0,0,0,18" />

                        <TextBlock Text="Шифр пояснительной записки *" />
                        <TextBox x:Name="NoteNumberTextBox"
                                 Margin="0,4,0,14" />

                        <TextBlock Text="Год составления *" />
                        <TextBox x:Name="NoteYearTextBox"
                                 Margin="0,4,0,14" />

                        <TextBlock Text="Гриф ограничения доступа" />
                        <TextBox x:Name="AccessRestrictionTextBox"
                                 Margin="0,4,0,14" />

                        <TextBlock Text="* Обязательность указана для полей, обязательных по XSD."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2. Автор">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="600"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Организация — автор пояснительной записки"
                                   FontSize="23" FontWeight="SemiBold"
                                   Margin="0,0,0,18" />

                        <TextBlock Text="Полное наименование" />
                        <TextBox x:Name="AuthorFullNameTextBox"
                                 Margin="0,4,0,14" />

                        <TextBlock Text="Сокращённое наименование" />
                        <TextBox x:Name="AuthorShortNameTextBox"
                                 Margin="0,4,0,14" />

                        <TextBlock Text="ОГРН" />
                        <TextBox x:Name="AuthorOgrnTextBox"
                                 Margin="0,4,0,14" />

                        <TextBlock Text="ИНН" />
                        <TextBox x:Name="AuthorInnTextBox"
                                 Margin="0,4,0,14" />

                        <TextBlock Text="Поля будут уточнены и дополнены по ограничениям XSD."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="3. Объект">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="600"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Объект капитального строительства"
                                   FontSize="23" FontWeight="SemiBold"
                                   Margin="0,0,0,18" />

                        <TextBlock Text="Тип объекта *" />
                        <ComboBox x:Name="ObjectTypeComboBox"
                                  SelectedIndex="0"
                                  Margin="0,4,0,14">
                            <ComboBoxItem Content="Непроизводственный"
                                          Tag="NonIndustrialObject" />
                            <ComboBoxItem Content="Производственный"
                                          Tag="IndustrialObject" />
                            <ComboBoxItem Content="Линейный"
                                          Tag="LinearObject" />
                        </ComboBox>

                        <TextBlock Text="Наименование объекта *" />
                        <TextBox x:Name="ObjectNameTextBox"
                                 Margin="0,4,0,14" />

                        <TextBlock Text="Идентификатор объекта (ObjectID) *" />
                        <TextBox x:Name="ObjectIdTextBox"
                                 Margin="0,4,0,14" />

                        <TextBlock Text="Это пока начальный набор полей. Для формирования корректного XML нужны остальные обязательные сведения по выбранному типу объекта."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
